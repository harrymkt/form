class nv_form_checkbox: nv_form_control {
	bool state = false;
	nv_form_checkbox(nv_form@parent, const string &in caption, const string &in id = "", bool initial_state = false) {
		super(caption, id, nv_form_ct_checkbox, @parent);
		this.state = initial_state;
	}
	void fire() {
		toggle();
		nv_form_control::fire();
	}
	string get_fixed_type_last() property {
		return (state ? "checked" : "not checked");
	}
	void toggle() {
		state = !state;
		event.fire(nv_form_event(this, nv_form_event_checkbox_toggled));
	}
	bool check() {
		if (state) return false;
		state = true;
		event.fire(nv_form_event(this, nv_form_event_checkbox_toggled));
		return true;
	}
	bool uncheck() {
		if (!state) return false;
		state = false;
		event.fire(nv_form_event(this, nv_form_event_checkbox_toggled));
		return true;
	}
	bool handle_input() {
		if (key_pressed(KEY_SPACE)) {
			fire();
			return true;
		}
		return false;
	}
}
